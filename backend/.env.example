# ================================================================
#  Copy this file to .env and fill in your actual keys
# ================================================================

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Meta WhatsApp Business API (primary number — runs the AI agent)
WHATSAPP_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WEBHOOK_VERIFY_TOKEN=dreamhome2025secret
# WABA_ID=your_whatsapp_business_account_id_here   # needed for template auto-lookup on /api/send and /api/broadcast-template

# ── Optional second number — broadcast/template sends only, no AI ──
# Leave unset if you only have one number. Set both to enable a
# "broadcast" channel in the dashboard's Broadcast / Template Campaign
# modals. Incoming messages on this number are ignored by the backend
# (no auto-reply, no lead capture) — reply to them yourself.
# WHATSAPP_TOKEN_2=
# WHATSAPP_PHONE_NUMBER_ID_2=
# WABA_ID_2=
# WHATSAPP_2_LABEL=Broadcast Number   # friendly name shown in the dashboard dropdown

# Supabase Database
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Sales Alert WhatsApp Number (with country code, no +)
SALES_PHONE_NUMBER=919876543210

# Server
PORT=3000
NODE_ENV=development

# ================================================================
# PropelloCRM Integration
# ================================================================
CRM_BASE_URL=https://propellocrm.onrender.com
CRM_WEBHOOK_SECRET=<shared-secret-identical-to-crm-whatsapp-webhook-secret>
CRM_TIMEOUT_MS=10000
